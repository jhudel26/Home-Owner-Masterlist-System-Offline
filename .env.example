# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=residential_masterlist

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Persistent Uploads Directory (optional in dev, defaults to ./public/uploads)
# In production installer, points to C:\ProgramData\ResidentialMasterlist\uploads
# UPLOAD_DIR=C:\ProgramData\ResidentialMasterlist\uploads

# Dev allowed origins (comma separated, optional)
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
